<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>RightRightRight-Setup</AssemblyName><Version>0.2.0</Version><DebugType>None</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained><PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../src/bin/Release/net6.0/RightRightRight.dll" LogicalName="mod.dll" />
    <EmbeddedResource Include="../levels/stages.json" LogicalName="stages.json" />
    <EmbeddedResource Include="../tools/supported-build.json" LogicalName="supported.json" />
    <EmbeddedResource Include="payload/player-delta.json" LogicalName="delta.json" />
  </ItemGroup>
</Project>
